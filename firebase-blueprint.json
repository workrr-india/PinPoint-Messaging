        "fingerprint": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["pin", "displayName", "userId"]
    },
    "Contact": {
      "title": "User Contact",
      "description": "Contact item in user directory",
      "type": "object",
      "properties": {
        "pin": { "type": "string" },
        "displayName": { "type": "string" },
        "statusMessage": { "type": "string" },
        "avatarColorHex": { "type": "string" },
