{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and cryptographic identity",
      "type": "object",
      "properties": {
        "pin": { "type": "string" },
        "displayName": { "type": "string" },
        "statusMessage": { "type": "string" },
        "avatarColorHex": { "type": "string" },
        "organization": { "type": "string" },
        "department": { "type": "string" },
        "jobTitle": { "type": "string" },
        "clearanceLevel": { "type": "string" },
